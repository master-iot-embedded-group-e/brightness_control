#include <zephyr/dt-bindings/pinctrl/stm32-pinctrl.h>
#include <zephyr/dt-bindings/pwm/pwm.h>

&timers2
{
	status = "okay";
	pwm {
		status = "okay";
		pinctrl-0 = <&tim2_ch2_pb3 &tim2_ch3_pb10>;
	};
};

&timers16
{
	status = "okay";
	pwm16: pwm {
		status = "okay";
		pinctrl-0 = <&tim16_ch1_pb8>;
		pinctrl-names = "default";
	};
};

/ {
	aliases {
		led0 = &blue_led_1; 	// This is LED1 as labeled STM32WL55JC board's
		led1 = &green_led_2; 	// This is LED2 as labeled STM32WL55JC board's
		led2 = &red_led_3; 	    // This is LED3 as labeled STM32WL55JC board's
		red-pwm-led = &red_pwm_led;
		green-pwm-led = &green_pwm_led;
		blue-pwm-led = &blue_pwm_led;
	};



	pwmleds {
		compatible = "pwm-leds";

		red_pwm_led: red_pwm_led {
			pwms = <&pwm2 2 15625000 PWM_POLARITY_INVERTED>;
		};

		green_pwm_led: green_pwm_led {
			pwms = <&pwm2 3 15625000 PWM_POLARITY_INVERTED>;
		};

		blue_pwm_led: blue_pwm_led {
			pwms = <&pwm16 1 15625000 PWM_POLARITY_INVERTED>;
		};
	};

};
