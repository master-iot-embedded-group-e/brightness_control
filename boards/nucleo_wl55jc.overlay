#include <zephyr/dt-bindings/pinctrl/stm32-pinctrl.h>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/adc/adc.h>

/ {
    zephyr,user {
        io-channels = <&adc1 5>;
        io-channel-names = "ldr";
    };

    aliases {
        ldrpower = &ldr_power;
		red = &external_led_0;
		green = &external_led_1;
		blue = &external_led_2;
    };

    leds {
        compatible = "gpio-leds";

        ldr_power: led_external_0 {
            gpios = <&gpiob 12 GPIO_ACTIVE_HIGH>;
            label = "LDR power at D2";
        };
		external_led_0: led_external_1 {
            gpios = <&gpiob 5 GPIO_ACTIVE_HIGH>;
            label = "RED LED at D4";
        };
		external_led_1: led_external_2 {
            gpios = <&gpioc 1 GPIO_ACTIVE_HIGH>;
            label = "GREEN LED at D7";
        };
		external_led_2: led_external_3 {
            gpios = <&gpioc 2 GPIO_ACTIVE_HIGH>;
            label = "BLUE LED at D8";
        };
    };
};

&adc1 {
    #address-cells = <1>;
    #size-cells = <0>;
    status = "okay";

    channel@5 {
        reg = <5>;
        zephyr,gain = "ADC_GAIN_1";
        zephyr,reference = "ADC_REF_INTERNAL";
        zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
        zephyr,resolution = <12>;
    };
};