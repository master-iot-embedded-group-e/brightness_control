{
  "terminal.integrated.env.linux": {
    "PROJECT_DIR": "${workspaceFolder}",
    "BUILD_DIR": "${workspaceFolder}/build",
    "CACHE_DIR": "${workspaceFolder}/.zephyr-cache/",
    "ZEPHYR_BOARD": "nucleo_wl55jc"
  },

  "C_Cpp.default.compileCommands":
    "${workspaceFolder}/build/compile_commands.json",

  // The module has no .clang-format of its own: format with Zephyr's style.
  "C_Cpp.clang_format_style":
    "file:${workspaceFolder}/../zephyr/.clang-format",

  "cortex-debug.armToolchainPrefix": "arm-zephyr-eabi",

  "cmake.sourceDirectory": "${workspaceFolder}"
}
